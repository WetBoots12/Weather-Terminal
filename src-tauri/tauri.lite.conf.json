{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOES-STAR Lite",
  "identifier": "com.wetboots12.goesstar.lite",
  "build": {
    "frontendDist": "../dist-lite",
    "beforeDevCommand": "npm run vendor && node scripts/build-lite.mjs",
    "beforeBuildCommand": "npm run vendor && node scripts/build-lite.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GOES-STAR Lite",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0a0a0a",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "shortDescription": "GOES satellite, radar and NWS forecast terminal (lightweight build for older computers)",
    "icon": [
      "icons-lite/32x32.png",
      "icons-lite/128x128.png",
      "icons-lite/128x128@2x.png",
      "icons-lite/icon.icns",
      "icons-lite/icon.ico"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOES-STAR",
  "version": "1.1.0",
  "identifier": "com.wetboots12.goesstar",
  "build": {
    "frontendDist": "../app",
    "beforeDevCommand": "npm run vendor",
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GOES-STAR Command",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0a0a0a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Weather",
    "shortDescription": "GOES satellite, radar and NWS forecast terminal",
    "copyright": "WetBoots12",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
